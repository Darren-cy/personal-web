---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found — Darren Yue Cao" description="The requested page could not be found.">
  <main class="not-found" id="main-content">
    <p class="eyebrow">404 / route unresolved</p>
    <h1>This path doesn’t lead anywhere.</h1>
    <p>The page may have moved, or the address may be incomplete.</p>
    <a class="primary-link" href="/">Return to the profile <span aria-hidden="true">↗</span></a>
  </main>
</BaseLayout>

